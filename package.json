    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.3.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "~5.3.0",
